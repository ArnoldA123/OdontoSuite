{
    "$schema": "https://json.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "lint": "eslint . --ext .vue,.js,.jsx,.ts,.tsx --fix",
        "lint:check": "eslint . --ext .vue,.js,.jsx,.ts,.tsx",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint:fix": "npm run lint && npm run format",
        "test": "php artisan test",
        "test:unit": "php artisan test --testsuite=Unit",
        "test:feature": "php artisan test --testsuite=Feature"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^6.0.1",
        "@vue/eslint-config-prettier": "^9.0.0",
        "autoprefixer": "^10.4.21",
        "axios": "^1.12.1",
        "concurrently": "^9.0.1",
        "eslint": "^8.57.0",
        "eslint-plugin-vue": "^9.22.0",
        "laravel-vite-plugin": "^2.0.1",
        "prettier": "^3.2.5",
        "tailwindcss": "^3.4.18",
        "vite": "^7.1.9",
        "vue": "^3.5.22"
    },
    "dependencies": {
        "@fullcalendar/core": "^6.1.19",
        "@fullcalendar/daygrid": "^6.1.19",
        "@fullcalendar/interaction": "^6.1.19",
        "@fullcalendar/timegrid": "^6.1.19",
        "@fullcalendar/vue3": "^6.1.19",
        "@heroicons/vue": "^2.2.0",
        "chart.js": "^4.5.0",
        "html2canvas": "^1.4.1",
        "jspdf": "^3.0.3",
        "vue-chartjs": "^5.3.2",
        "vue-router": "^4.5.1",
        "xlsx": "^0.18.5"
    }
}

