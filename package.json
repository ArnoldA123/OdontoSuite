{
    "$schema": "https://json.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "lint": "eslint . --ext .vue,.js,.jsx,.ts,.tsx --fix",
        "lint:check": "eslint . --ext .vue,.js,.jsx,.ts,.tsx",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint:fix": "npm run lint && npm run format",
        "test": "php artisan test",
        "test:unit": "php artisan test --testsuite=Unit",
        "test:feature": "php artisan test --testsuite=Feature"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^5.2.4",
        "@vue/eslint-config-prettier": "^8.0.0",
        "autoprefixer": "^10.4.16",
        "axios": "^1.6.0",
        "concurrently": "^8.2.0",
        "eslint": "^8.55.0",
        "eslint-plugin-vue": "^9.19.0",
        "laravel-vite-plugin": "^1.3.0",
        "prettier": "^3.1.0",
        "tailwindcss": "^3.3.0",
        "vite": "^5.4.21",
        "vue": "^3.3.0"
    },
    "dependencies": {
        "@fullcalendar/core": "^6.1.0",
        "@fullcalendar/daygrid": "^6.1.0",
        "@fullcalendar/interaction": "^6.1.0",
        "@fullcalendar/timegrid": "^6.1.0",
        "@fullcalendar/vue3": "^6.1.0",
        "@heroicons/vue": "^2.0.0",
        "chart.js": "^4.4.0",
        "html2canvas": "^1.4.0",
        "jspdf": "^2.5.0",
        "laravel-echo": "^1.16.1",
        "pusher-js": "^7.6.0",
        "vue-chartjs": "^5.3.0",
        "vue-router": "^4.2.0",
        "xlsx": "^0.18.0"
    }
}
