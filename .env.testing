APP_NAME=OdontoSuite
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# Sprint 4 fix (IM-1): MySQL para tests (mismo motor que produccion).
# En CI, el job configura DB_CONNECTION=mysql via env del runner.
# En local con SQLite, descomentar el bloque SQLite mas abajo y comentar MySQL.
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

BROADCAST_CONNECTION=log
CACHE_DRIVER=array
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=array

# Reverb/Push credentials: necesarios para que broadcasting no falle al
# bootstrap. Con BROADCAST_CONNECTION=log los mensajes no se envian,
# solo se loguean (no requiere un servidor real).
REVERB_APP_ID=testing-app-id
REVERB_APP_KEY=testing-app-key
REVERB_APP_SECRET=testing-app-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
